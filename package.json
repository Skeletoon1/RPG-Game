{
  "name": "overlord-rpg",
  "productName": "Overlord RPG",
  "version": "1.0.13",
  "description": "Overlord RPG — Nazarick Rising: a turn-based RPG inspired by the Overlord light novel/anime.",
  "author": "Nazarick",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nazarick.overlordrpg",
    "productName": "Overlord RPG",
    "asar": true,
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Skeletoon1",
      "repo": "RPG-Game",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "OverlordRPG-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "artifactName": "OverlordRPG-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "OverlordRPG-${version}.${ext}"
    }
  }
}
